# Experimental classic ESP32: no assumed battery or output wiring.
CONFIG_RMT_TX_ISR_CACHE_SAFE=y

# Persistent offline product control with the native NimBLE host.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# The controller holds a link only for a connection the host can use.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=6
# Six bonds, each retaining Service Changed, custom state and two BAS CCCDs.
CONFIG_BT_NIMBLE_MAX_CCCDS=24
CONFIG_BT_NIMBLE_GATT_CACHING=n
# 517 carries a whole 512-byte RPC2 request in one ATT write and its reply in one read.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# Two lighting centrals, no mesh; runtime coexistence remains a bench gate.
# Keep SC and the host stack; only bound queued packets.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15

# No PSRAM: bound Wi-Fi buffering so BLE, rendering and HTTP can coexist.
# A garment's dashboard needs no aggregated frames, and aggregation is what
# holds frames back in RAM; ten management buffers serve one station and AP.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=10

# Classic ESP32 reserves level 5 for the RMT refill. IDF places its system
# checks on level 4 when the Bluetooth controller's high-level mode is off.
CONFIG_BTDM_CTRL_HLI=n
CONFIG_ESP_SYSTEM_CHECK_INT_LEVEL_4=y

# A 4 MiB target has a smaller app slot; preserve features and measure size.
# Actual RMT refill timing under WiFi/BLE must be qualified on the board.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
